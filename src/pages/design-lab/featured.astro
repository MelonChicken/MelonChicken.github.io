---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const notes = (await getCollection('notes')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = notes.find((note) => note.data.featured) || notes[0];
const title = featured?.data.title || '[Reading Note] Self-Supervised Learning from Images with a Joint-Embedding Predictive Architecture';
const summary = featured?.data.summary || 'I-JEPA는 보이는 context로부터 가려진 영역의 abstract representation을 예측함으로써 high-level semantic representation을 효율적으로 학습하는 self-supervised learning framework이다.';
const fields = featured?.data.researchFields || ['Self-supervised Learning', 'Computer Vision'];
const href = featured ? `/notes/${featured.data.slug}/` : '#';
const date = featured ? new Intl.DateTimeFormat('en', { month: 'short', day: '2-digit', year: 'numeric' }).format(featured.data.date) : 'Sep 09, 2026';
---

<BaseLayout title="Featured story studies · Junu's Lab">
  <header class="lab-intro">
    <span>Design study</span>
    <h1>Featured story</h1>
    <p>The same note in three layouts. All options keep the title, summary, fields, date, and article link.</p>
  </header>

  <div class="studies">
    <section class="study">
      <div class="study-label"><b>A</b><div><strong>Metadata rail</strong><span>Structured and research-oriented</span></div></div>
      <article class="preview option-a">
        <aside>
          <span class="eyebrow-local">Featured / Paper Review</span>
          <time>{date}</time>
          <div class="field-list">{fields.map((field) => <span>{field}</span>)}</div>
          <a href={href}>Read note <span aria-hidden="true">→</span></a>
        </aside>
        <div class="story"><h2>{title}</h2><p>{summary}</p></div>
      </article>
    </section>

    <section class="study">
      <div class="study-label"><b>B</b><div><strong>Lead story</strong><span>Recommended · compact and direct</span></div></div>
      <article class="preview option-b">
        <div class="story-top"><span class="eyebrow-local">Featured / Paper Review</span><time>{date}</time></div>
        <div class="lead-grid">
          <h2>{title}</h2>
          <div><p>{summary}</p><div class="field-list">{fields.map((field) => <span>{field}</span>)}</div></div>
        </div>
        <a class="read-line" href={href}><span>Read featured note</span><span aria-hidden="true">→</span></a>
      </article>
    </section>

    <section class="study">
      <div class="study-label"><b>C</b><div><strong>Abstract card</strong><span>Quiet, academic, and familiar</span></div></div>
      <article class="preview option-c">
        <div class="story-top"><span class="eyebrow-local">Featured / Paper Review</span><time>{date}</time></div>
        <h2>{title}</h2>
        <p>{summary}</p>
        <footer><div class="field-list">{fields.map((field) => <span>{field}</span>)}</div><a href={href}>Read note <span aria-hidden="true">→</span></a></footer>
      </article>
    </section>
  </div>

  <style>
    .lab-intro{max-width:760px;margin:4px auto 42px;text-align:center}.lab-intro>span{color:var(--color-accent);font-size:.75rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.lab-intro h1{margin:.35rem 0 .25rem;font-size:clamp(1.7rem,3vw,2.35rem);letter-spacing:-.035em}.lab-intro p{margin:0;color:var(--color-text-secondary)}
    .studies{display:grid;gap:42px}.study{display:grid;grid-template-columns:190px minmax(0,1fr);gap:20px;align-items:start}.study-label{display:flex;gap:12px;align-items:flex-start;padding-top:16px}.study-label>b{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;color:var(--color-text-inverse);background:var(--color-accent)}.study-label div{display:flex;flex-direction:column}.study-label strong{font-size:.9rem}.study-label span{color:var(--color-text-secondary);font-size:.74rem;line-height:1.45}
    .preview{overflow:hidden;border:1px solid var(--color-border);border-left:3px solid var(--color-accent);border-radius:var(--radius-md);background:var(--color-surface);box-shadow:var(--shadow-sm)}.preview h2{color:var(--color-text-primary);letter-spacing:-.035em;text-wrap:balance}.preview p{color:var(--color-text-secondary)}.eyebrow-local{color:var(--color-accent);font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.eyebrow-local::before{content:"> ";color:var(--color-text-secondary)}time{color:var(--color-text-secondary);font-size:.75rem}.field-list{display:flex;flex-wrap:wrap;gap:7px}.field-list span{padding:4px 8px;border:1px solid var(--color-border);border-radius:var(--radius-sm);color:var(--color-text-secondary);background:var(--color-bg);font-size:.72rem}.preview a{color:var(--color-link);font-size:.82rem;font-weight:700}
    .option-a{display:grid;grid-template-columns:220px minmax(0,1fr);min-height:300px}.option-a aside{display:flex;flex-direction:column;align-items:flex-start;gap:15px;padding:34px 28px;border-right:1px solid var(--color-divider);background:var(--color-bg)}.option-a aside a{margin-top:auto}.option-a .story{align-self:center;padding:42px 48px}.option-a h2{max-width:31ch;margin:0 0 16px;font-size:clamp(1.65rem,3vw,2.45rem);line-height:1.12}.option-a p{max-width:68ch;margin:0;font-size:.94rem}
    .option-b{padding:30px 34px}.story-top{display:flex;align-items:center;justify-content:space-between;gap:16px}.option-b .lead-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(280px,.75fr);gap:44px;align-items:end;padding:25px 0 27px}.option-b h2{margin:0;font-size:clamp(1.55rem,2.7vw,2.25rem);line-height:1.13}.option-b p{margin:0 0 16px;font-size:.9rem}.read-line{display:flex;justify-content:space-between;padding-top:14px;border-top:1px solid var(--color-divider)}
    .option-c{display:flex;flex-direction:column;align-items:center;padding:38px 48px;text-align:center}.option-c .story-top{width:100%}.option-c h2{max-width:32ch;margin:24px auto 14px;font-size:clamp(1.55rem,2.8vw,2.3rem);line-height:1.13}.option-c>p{max-width:70ch;margin:0 auto 24px;font-size:.92rem}.option-c footer{display:flex;align-items:center;justify-content:space-between;width:100%;padding-top:16px;border-top:1px solid var(--color-divider)}
    @media(max-width:820px){.study{grid-template-columns:1fr}.study-label{padding-top:0}.option-a,.option-b .lead-grid{grid-template-columns:1fr}.option-a aside{border-right:0;border-bottom:1px solid var(--color-divider)}.option-a aside a{margin-top:4px}.option-a .story{padding:32px 28px}.option-b .lead-grid{gap:18px}}
    @media(max-width:520px){.option-b,.option-c{padding:28px 22px}.story-top,.option-c footer{align-items:flex-start;flex-direction:column}.option-a h2,.option-b h2,.option-c h2{font-size:1.55rem}.option-c{text-align:left}.option-c h2,.option-c>p{margin-left:0}.preview{border-radius:var(--radius-sm)}}
  </style>
</BaseLayout>
