---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Tag from '../components/Tag.astro';
import { formatDate, getFeaturedProjects, getRecentNotes, validateContentLinks } from '../lib/content';

await validateContentLinks();
const [featuredProjects, recentNotes] = await Promise.all([getFeaturedProjects(), getRecentNotes(5)]);
function compactSummary(summary?: string, maxLength = 120) {
  if (!summary) return '';
  const normalized = summary.replace(/\s+/g, ' ').trim();
  return normalized.length <= maxLength ? normalized : `${normalized.slice(0, maxLength).trimEnd()}...`;
}
---

<BaseLayout title="Junu's Lab">
  <section class="home-hero">
    <div class="hero-copy">
      <Eyebrow text="Computer Vision / Machine Learning" />
      <h1>Understanding animal behavior through vision.</h1>
      <p class="hero-role">Research-oriented builder based in Seoul.</p>
      <p class="hero-intro">I study how machines can understand animal behavior from raw video, with a focus on pose estimation, action recognition, and efficient annotation.</p>
      <div class="hero-actions">
        <a class="btn primary" href="/projects/">View projects</a>
        <a class="btn" href="/notes/">Read lab notes</a>
        <a class="btn btn-icon" href="/contact/"><span class="mail-icon" aria-hidden="true"></span>Contact</a>
      </div>
    </div>
    <figure class="profile-card">
      <div class="profile-frame">
        <div class="profile-placeholder" aria-hidden="true"><i class="fa-regular fa-user"></i><b>PROFILE PHOTO</b><span>4:5 portrait</span><code>public/images/profile.jpg</code></div>
        <img src="/images/profile.jpg" alt="Portrait of Junu" onerror="this.hidden=true" />
      </div>
      <figcaption><span>Junu</span><span>Seoul, KR</span></figcaption>
    </figure>
  </section>

  <section class="focus-strip" aria-label="Research focus">
    <span class="focus-label">Current focus</span>
    <div class="focus-topics"><Tag label="Animal behavior analysis" /><Tag label="Pose estimation" /><Tag label="Video understanding" /><Tag label="Annotation automation" /></div>
  </section>

  <section class="panel how-i-work">
    <div><Eyebrow text="How I Work" /><h2>From reading to reproducible output</h2></div>
    <ol>
      <li><b>01</b><span>Build small, reproducible machine learning and computer vision experiments.</span></li>
      <li><b>02</b><span>Track useful papers, datasets, tools, and benchmarks.</span></li>
      <li><b>03</b><span>Turn research reading into lab notes, project ideas, and working artifacts.</span></li>
    </ol>
  </section>
  <section class="home-section">
    <div class="home-section-head"><div><Eyebrow text="Selected Work" /><h2>Featured projects</h2></div><a href="/projects/">All projects <span aria-hidden="true">→</span></a></div>
    {featuredProjects.length > 0 ? (
      <div class="grid cols-2">
        {featuredProjects.slice(0, 4).map((project) => <Card href={`/projects/${project.data.slug}/`} title={project.data.title} status={project.data.status} summary={compactSummary(project.data.problem ?? project.data.summary)} tags={project.data.domain} meta={project.data.group} />)}
      </div>
    ) : <section class="panel"><p class="muted">No featured projects selected yet.</p></section>}
  </section>

  <section class="home-section writing-section">
    <div class="home-section-head"><div><Eyebrow text="Recent Writing" /><h2>Latest lab notes</h2></div><a href="/notes/">Full archive <span aria-hidden="true">→</span></a></div>
    <div class="writing-list">
      {recentNotes.map((note) => (
        <a class="writing-row" href={`/notes/${note.data.slug}/`}>
          <span class="writing-date">{formatDate(note.data.date)}</span>
          <span class="writing-copy"><b>{note.data.title}</b>{note.data.summary && <small>{compactSummary(note.data.summary, 105)}</small>}</span>
          <span class="writing-open" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <style>
    .home-hero{display:grid;grid-template-columns:minmax(0,1fr) 230px;gap:clamp(32px,7vw,82px);align-items:center;padding:44px 0 50px;border-bottom:1px solid var(--color-border)}
    .hero-copy h1{max-width:16ch;margin:.45rem 0 .8rem;font-size:clamp(2.2rem,4.8vw,4.25rem);line-height:1;letter-spacing:-.05em}
    .hero-role{margin:0 0 .65rem;color:var(--color-accent);font-weight:600}.hero-intro{max-width:58ch;margin:0;color:var(--color-text-secondary);font-size:1.02rem}.hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:25px}
    .profile-card{width:100%;max-width:230px;margin:0;justify-self:end}.profile-frame{position:relative;aspect-ratio:4/5;overflow:hidden;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-md);box-shadow:var(--shadow-sm)}
    .profile-frame::after{content:'';position:absolute;inset:auto 12px 12px auto;width:24px;height:24px;border-right:2px solid var(--color-accent);border-bottom:2px solid var(--color-accent);pointer-events:none}.profile-frame img{position:absolute;z-index:2;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}
    .profile-placeholder{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;padding:18px;color:var(--color-text-secondary);text-align:center}.profile-placeholder i{margin-bottom:5px;color:var(--color-accent);font-size:2rem}.profile-placeholder b{color:var(--color-text-primary);font-size:.72rem;letter-spacing:.1em}.profile-placeholder span{font-size:.7rem}.profile-placeholder code{margin-top:3px;padding:4px 6px;background:var(--color-bg);border:1px solid var(--color-border);border-radius:var(--radius-sm);font-size:.58rem}
    .profile-card figcaption{display:flex;justify-content:space-between;gap:12px;padding:8px 2px 0;color:var(--color-text-secondary);font-size:.72rem}.profile-card figcaption span:first-child{color:var(--color-text-primary);font-weight:600}
    .focus-strip{display:flex;align-items:center;gap:18px;padding:18px 0;border-bottom:1px solid var(--color-divider)}.focus-label{flex:0 0 auto;color:var(--color-text-secondary);font-size:.74rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase}.focus-topics{display:flex;gap:7px;flex-wrap:wrap}
    .how-i-work{display:grid;grid-template-columns:.7fr 1.3fr;gap:30px;margin-top:18px}.how-i-work h2{margin:.35rem 0 0;font-size:1rem}.how-i-work ol{margin:0;padding:0;list-style:none}.how-i-work li{display:grid;grid-template-columns:34px 1fr;gap:10px;padding:9px 0;border-top:1px solid var(--color-divider);font-size:.86rem}.how-i-work li:first-child{border-top:0}.how-i-work li b{color:var(--color-accent)}
    .home-section{padding-top:44px}.home-section-head{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:16px}.home-section-head h2{margin:.3rem 0 0;font-size:1.16rem}.home-section-head>a{color:var(--color-link);font-size:.82rem;font-weight:600}.writing-section{padding-bottom:10px}.writing-list{border-top:1px solid var(--color-border)}
    .writing-row{display:grid;grid-template-columns:110px minmax(0,1fr) 32px;gap:18px;align-items:center;padding:17px 0;border-bottom:1px solid var(--color-divider)}.writing-date{color:var(--color-text-secondary);font-size:.74rem}.writing-copy{min-width:0}.writing-copy b{display:block;line-height:1.35}.writing-copy small{display:block;margin-top:3px;overflow:hidden;color:var(--color-text-secondary);font-size:.8rem;text-overflow:ellipsis;white-space:nowrap}.writing-open{display:grid;place-items:center;width:30px;height:30px;border:1px solid var(--color-border);border-radius:var(--radius-sm);color:var(--color-text-secondary)}.writing-row:hover b,.writing-row:hover .writing-open{color:var(--color-accent)}.writing-row:hover .writing-open{border-color:var(--color-accent)}
    @media(max-width:760px){.home-hero,.how-i-work{grid-template-columns:1fr}.home-hero{padding-top:22px}.profile-card{max-width:210px;justify-self:start}.focus-strip{align-items:flex-start;flex-direction:column;gap:9px}.writing-row{grid-template-columns:1fr 30px;gap:8px 12px}.writing-date{grid-column:1/-1}.cols-2{grid-template-columns:1fr}}@media(max-width:480px){.hero-copy h1{font-size:2.25rem}.home-section-head{align-items:flex-start;flex-direction:column;gap:8px}.writing-copy small{white-space:normal}}
  </style>
</BaseLayout>
